APP_ENV=development
PORT=8080
DATABASE_URL=postgres://postgres:postgres@localhost:5432/toko?sslmode=disable
# Database Connection Pool Settings
DB_MAX_OPEN_CONNS=5
DB_MAX_IDLE_CONNS=1
WORKER_DB_MAX_OPEN_CONNS=2
WORKER_DB_MAX_IDLE_CONNS=1
DB_CONN_MAX_LIFETIME_MIN=30

REDIS_URL=redis://localhost:6379
JWT_SECRET=change-me
CORS_ALLOWED_ORIGINS=http://localhost:3000
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_BASE_URL=https://app.sandbox.midtrans.com
PAYMENT_PROVIDER=midtrans
PAYMENT_SANDBOX=true
XENDIT_SECRET_KEY=
XENDIT_CALLBACK_TOKEN=
XENDIT_BASE_URL=https://api.xendit.co
PAYMENT_BANK_NAME=BCA
PAYMENT_BANK_ACCOUNT_NAME=toko
PAYMENT_BANK_ACCOUNT_NUMBER=
PAYMENT_QR_URL=
RAJAONGKIR_API_KEY=
RAJAONGKIR_BASE_URL=https://api.rajaongkir.com/starter
# Deterministic local rates; use rajaongkir only with a valid API key.
SHIPPING_PROVIDER=rajaongkir-mock
SHIPPING_ORIGIN_CODE=KOTA_KEDIRI
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=720h
COOKIE_DOMAIN=
COOKIE_SECURE=false
COOKIE_SAMESITE=Lax

# Browser CSRF double-submit token. The cookie name matches
# SECURITY_CSRF_HEADER and is bootstrapped on safe requests.
SECURITY_CSRF_ENABLED=true
SECURITY_CSRF_HEADER=X-CSRF-Token
SECURITY_CSRF_COOKIE_DOMAIN=
SECURITY_CSRF_COOKIE_PATH=/
SECURITY_CSRF_COOKIE_SECURE=false
SECURITY_CSRF_COOKIE_SAMESITE=Lax
SECURITY_CSRF_COOKIE_MAX_AGE_SEC=86400

# Disabled by default; expose pprof only on a protected internal endpoint.
OBS_ENABLE_PPROF=false

# Tenant every unscoped request falls back to. Leave unset to resolve the
# tenant seeded with slug='default' from the database.
TENANT_DEFAULT_ID=

# Request limits. The E2E suite drives far more traffic from one host than a
# real user, so raise these when running it (see toko/run-visual-real-api-tests.sh).
RATE_LIMIT_GLOBAL_MAX=1200
RATE_LIMIT_USER_MAX=120

# Transactional email. Without SMTP_HOST the API starts with delivery disabled
# and logs a warning; password reset and email verification tokens are still
# created but nobody receives them.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
# Defaults to NOTIFY_FROM_EMAIL when unset.
SMTP_FROM=
# Dial TLS immediately (port 465) instead of upgrading via STARTTLS (port 587).
SMTP_IMPLICIT_TLS=false
# Local relays with self-signed certificates only. Never enable in production.
SMTP_ALLOW_INSECURE_TLS=false
SMTP_TIMEOUT_SEC=10

# Storefront origin used to build links inside those emails. Without it the
# links are relative and unusable in a mail client.
PUBLIC_BASE_URL=http://localhost:3000

# Web push (VAPID). Generate keys with `make vapid-keys`. Leave both empty to
# boot with push disabled (GET /push/vapid-key and POST /push/send-test answer
# 503 PUSH_DISABLED); setting only one is a startup error. The private key is a
# secret: never commit a real value.
PUSH_VAPID_PUBLIC_KEY=
PUSH_VAPID_PRIVATE_KEY=
# mailto:<addr>, <addr> or https://... Defaults to mailto:<NOTIFY_FROM_EMAIL>.
PUSH_VAPID_SUBJECT=
PUSH_TTL_SEC=86400
# Comma-separated push-service hosts accepted as subscription endpoints. Empty
# uses the default: fcm.googleapis.com,.push.services.mozilla.com,
# .notify.windows.com,web.push.apple.com,.push.apple.com  ("." prefix matches
# subdomains; "*" accepts any https DNS host).
PUSH_ENDPOINT_ALLOWED_HOSTS=
PUSH_MAX_SUBSCRIPTIONS_PER_USER=10
# POST /push/send-test budget per user.
RATE_LIMIT_PUSH_TEST_WINDOW_SEC=60
RATE_LIMIT_PUSH_TEST_MAX=5

# cmd/worker delivers email and push from the queue and runs the outbox relay.
QUEUE_CONCURRENCY_PUSH=4
# Re-dispatch domain events whose fan-out did not complete: sweep interval,
# grace period before an event counts as stuck, how far back to look, and how
# many attempts per event.
OUTBOX_RELAY_INTERVAL_SEC=15
OUTBOX_RELAY_MIN_AGE_SEC=30
OUTBOX_RELAY_MAX_AGE_SEC=86400
OUTBOX_RELAY_MAX_ATTEMPTS=10
