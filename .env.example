APP_ENV=development
PORT=8080
DATABASE_URL=postgres://postgres:postgres@localhost:5432/toko?sslmode=disable
REDIS_URL=redis://localhost:6379
JWT_SECRET=change-me
CORS_ALLOWED_ORIGINS=http://localhost:3000
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
RAJAONGKIR_API_KEY=
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=720h
COOKIE_DOMAIN=
COOKIE_SECURE=false
COOKIE_SAMESITE=Lax

# Tenant every unscoped request falls back to. Leave unset to resolve the
# tenant seeded with slug='default' from the database.
TENANT_DEFAULT_ID=

# Request limits. The E2E suite drives far more traffic from one host than a
# real user, so raise these when running it (see toko/run-visual-real-api-tests.sh).
RATE_LIMIT_GLOBAL_MAX=1200
RATE_LIMIT_USER_MAX=120
